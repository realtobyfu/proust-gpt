# ProustGPT Backend Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED SETTINGS
# =============================================================================

# Pinecone API key (get from https://www.pinecone.io/)
PINECONE_API_KEY=your-pinecone-api-key-here

# Groq API key (get from https://console.groq.com/)
GROQ_API_KEY=your-groq-api-key-here

# Cohere API key (get from https://dashboard.cohere.com/)
COHERE_API_KEY=your-cohere-api-key-here

# =============================================================================
# OPTIONAL SETTINGS (defaults shown)
# =============================================================================

# Pinecone settings
# Uses namespaces: "en" (EN embeddings), "fr" (FR embeddings)
PINECONE_INDEX_NAME=proust-index-v2

# LLM settings
LLM_MODEL_NAME=moonshotai/kimi-k2-instruct
LLM_TEMPERATURE=0.7          # Response randomness (0.0-1.0)

# Cohere model settings
COHERE_EMBED_MODEL=embed-v4.0
COHERE_RERANK_MODEL=rerank-v3.5
RERANK_TOP_N=5

# App settings
SECRET_KEY=change-this-to-a-random-secret-key
DEBUG=true

# RAG settings
RETRIEVAL_K=5                 # Final number of passages returned
RETRIEVAL_CANDIDATES=20       # Candidates fetched before reranking
